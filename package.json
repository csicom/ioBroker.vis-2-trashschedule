  },
  "keywords": [
    "ioBroker",
    "visualization",
    "trashschedule"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^3.8.0",
    "@alcalzone/release-script-plugin-iobroker": "^3.7.2",
    "@alcalzone/release-script-plugin-license": "^3.7.0",
    "@alcalzone/release-script-plugin-manual-review": "^3.7.0",
    "@iobroker/build-tools": "^2.0.15",
    "@iobroker/eslint-config": "^1.0.0",
    "@iobroker/vis-2-widgets-react-dev": "^4.0.4",
    "@iobroker/vis-2-widgets-testing": "^1.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.14",
    "mocha": "^11.1.0"
  },
  "files": [
    "admin/",
    "img/",
    "io-package.json",
    "LICENSE",
    "widgets/"
  ],
  "scripts": {
    "lint": "eslint -c eslint.config.mjs",
    "build": "node tasks",
    "copy-files": "node tasks --copy-files",
    "lint:fix": "eslint --fix eslint.config.mjs",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "test": "mocha ./test/*.test.js",
    "update-packages": "ncu --upgrade && cd src-widgets && ncu --upgrade && cd ..",
    "npm": "npm i -f && cd src-widgets && npm i -f && cd ..",
